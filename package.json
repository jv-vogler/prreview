{
	"name": "@jv-vogler/prreview",
	"version": "0.0.1",
	"description": "GitHub-style diff viewer on localhost for reviewing PRs, branches, commit ranges, and working-tree changes",
	"keywords": [
		"code-review",
		"diff",
		"pull-request",
		"git",
		"cli",
		"review",
		"local-first"
	],
	"homepage": "https://github.com/jv-vogler/prreview#readme",
	"bugs": {
		"url": "https://github.com/jv-vogler/prreview/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jv-vogler/prreview.git"
	},
	"license": "MIT",
	"author": "João Vogler",
	"type": "module",
	"bin": {
		"prreview": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"build": "tsdown && vite build src/client",
		"dev": "concurrently \"tsx watch src/interface/cli/index.ts --dev $PRREVIEW_DEV_TARGET\" \"vite src/client\"",
		"dev:mock": "PATH=\"$PWD/scripts/mock-agent:$PATH\" npm run dev",
		"link": "npm run build && npm link",
		"unlink": "npm unlink -g @jv-vogler/prreview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "biome check . && stylelint \"src/**/*.css\" --allow-empty-input && node scripts/check-dto-imports.mjs",
		"typecheck": "tsc -b",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@pierre/diffs": "1.3.5",
		"@primer/octicons-react": "^19.33.0",
		"@primer/primitives": "^11.10.0",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tanstack/react-query": "^5.101.4",
		"commander": "^15.0.0",
		"diff": "^9.0.0",
		"get-port": "^7.2.0",
		"gitdiff-parser": "^0.3.1",
		"hono": "^4.13.2",
		"open": "^11.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"react-router": "^8.3.0",
		"remark-gfm": "^4.0.1",
		"ulid": "^3.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@playwright/test": "^1.62.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"ajv": "8.20.0",
		"concurrently": "^10.0.5",
		"jsdom": "^29.1.1",
		"stylelint": "^17.14.1",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
