#!/usr/bin/env node
// A mock `claude` for looking at the UI without paying an agent.
//
// This is a *generator*, not a replay. `test/bin/claude` replays a recorded
// stream byte for byte, which is what a test wants and exactly what UI work
// cannot use: a recording's hunk ids belong to the repo it was recorded
// against, so against any other changeset every topic silently falls back to
// whole-file refs and the screen you are trying to look at is not the screen
// users get. This one reads the numbered diff out of the prompt it was handed
// and answers with topics wired to the hunk ids actually in front of it.
//
// It is a real agent as far as everything else is concerned. It goes on PATH
// as `claude`, so the run manager, the progress events, the SSE channel, the
// zod gates, the store and the client all run the production path. Nothing in
// `src/` knows it exists.
//
// CJS on purpose — extensionless scripts load as CJS regardless of the root
// "type": "module", same as test/bin/claude.
//
// Usage:  npm run dev:mock     (then click "Explain this change")
//
// Knobs:
//   MOCK_AGENT_VERDICT   matches | partly | diverges | unclear  (default matches)
//   MOCK_AGENT_DELAY_MS  ms between emitted lines (default 150; 0 for instant)
//   MOCK_AGENT_FAIL      any value → terminal failure, for the error surface
//   MOCK_AGENT_SEED      override the prompt-derived seed
//   MOCK_AGENT_REVIEW    silent → every lens finds nothing, for the empty state

const { createHash } = require("node:crypto");
const { readFileSync } = require("node:fs");
const { setTimeout: sleep } = require("node:timers/promises");
const { buildReview } = require("./review");

const VERSION = "0.0.0-mock (prreview mock agent)";
const DEFAULT_DELAY_MS = 150;
const SESSION_ID = "00000000-mock-4000-8000-000000000000";

/** the comprehension prompt's own words — see application/analysis/understandingTask.ts */
const COMPREHENSION_MARKER =
	"Produce the understanding object described by the output schema.";

/**
 * The review prompt's own words — see application/review/reviewTask.ts.
 *
 * The marker doubles as the lens discriminator, which this mock cannot do
 * without: it is spawned once per lens child, and a mock that cannot tell which
 * lens it is answers identically five times over. Every row would then arrive
 * corroborated by five lenses and the merge demonstration would be gone.
 */
const REVIEW_LENS_MARKER =
	/^You are reviewing a code change through one lens: \*\*([a-z-]+)\*\*\./m;
const FRESH_EYES_MARKER = "You are reviewing a code change you know nothing about.";
/** `Your working directory, <dir>, holds the code at the reviewed revision.` */
const WORKSPACE_MARKER = /^Your working directory, (.+?), holds the code/m;
/** the floor lives in ReviewDepth and reaches the agent only as this sentence */
const FLOOR_MARKER = /Report nothing below (\d+) confidence/;
const DEFAULT_CONFIDENCE_FLOOR = 80;

const argv = process.argv.slice(2);

async function main() {
	if (argv.includes("--version") || argv.includes("-v")) {
		process.stdout.write(`${VERSION}\n`);
		return;
	}

	const prompt = readStdinToEnd();
	const schema = parseJsonFlag("--json-schema");
	const random = seededRandom(
		process.env.MOCK_AGENT_SEED ?? sha(prompt).slice(0, 16),
	);

	const isComprehension = prompt.includes(COMPREHENSION_MARKER);
	const lens = reviewLensOf(prompt);
	const files = parseNud(prompt);

	if (isComprehension && schema !== null) {
		await emit(narration(files), buildUnderstanding(files, schema, random));
		return;
	}
	if (lens !== null && schema !== null && isReviewSchema(schema)) {
		const review =
			process.env.MOCK_AGENT_REVIEW === "silent"
				? { output: { findings: [], relatedFindings: [] }, toolCalls: [] }
				: buildReview({
						lens,
						files,
						schema,
						workspaceDir: parseWorkspaceDir(prompt),
						confidenceFloor: parseConfidenceFloor(prompt),
						suppressions: parseSuppressions(prompt),
					});
		await emit(review.toolCalls, review.output);
		return;
	}

	await emit(narration(files), schema === null ? null : instanceOf(schema, random));
}

/**
 * Which lens this child is, or null when the prompt is not a review at all.
 *
 * If the prompt sentence is ever reworded this returns null and the review falls
 * back to schema-shaped lorem — which the confidence floor then discards
 * entirely, exactly the failure this generator exists to fix. `isReviewSchema`
 * is the second signal, so a reworded first line degrades to one lens's rows
 * rather than to nothing.
 */
function reviewLensOf(prompt) {
	const matched = REVIEW_LENS_MARKER.exec(prompt);
	if (matched !== null) {
		return matched[1];
	}
	if (prompt.includes(FRESH_EYES_MARKER)) {
		return "fresh-eyes";
	}
	return null;
}

function isReviewSchema(schema) {
	const properties = schema.properties ?? {};
	return (
		properties.findings !== undefined && properties.relatedFindings !== undefined
	);
}

/**
 * The workspace dir, parsed rather than taken from `process.cwd()`.
 *
 * This string is what adjudication strips off the read log before comparing it
 * to a citation, so it has to be byte-identical to the one in the prompt. Using
 * cwd works right up until a symlinked repo root or a realpath'd temp dir makes
 * the two differ — and then nothing is grounded, every blocker is dropped, and
 * the board is empty for a reason that looks nothing like its cause.
 */
function parseWorkspaceDir(prompt) {
	return WORKSPACE_MARKER.exec(prompt)?.[1] ?? process.cwd();
}

function parseConfidenceFloor(prompt) {
	const matched = FLOOR_MARKER.exec(prompt);
	return matched === null ? DEFAULT_CONFIDENCE_FLOOR : Number(matched[1]);
}

/** the `## Already dismissed` list, so a dismissed comment stays dismissed */
function parseSuppressions(prompt) {
	const section = prompt.split("## Already dismissed")[1];
	if (section === undefined) {
		return [];
	}
	const titles = [];
	for (const line of section.split("\n")) {
		if (line.startsWith("## ")) {
			break;
		}
		if (line.startsWith("- ")) {
			titles.push(line.slice(2).trim());
		}
	}
	return titles;
}

// ── the numbered diff, read back out of the prompt ──────────────────────────

/**
 * Pulls the files, hunk ids and numbered rows out of the NUD the prompt carries.
 *
 * This is the whole reason the mock generates rather than replays. The topic
 * refs it emits have to name hunk ids this round actually has, or
 * `buildExcerpts` resolves nothing, falls back to whole files, and the
 * Understanding tab renders a shape no real run produces. The review generator
 * needs one thing more — the printed line numbers — because an anchor is only
 * `in-diff`, and a balloon only lands in the margin, if it names lines a hunk
 * really has.
 *
 * Deliberately tolerant: an unparseable prompt yields an empty file list and
 * the mock still answers, because a mock that throws on a diff shape it did
 * not expect is worse than one that shows an empty change.
 */
const NUD_FILE = /^=== FILE (\S+)\s{2}(.+?)\s{2}\(/;
const NUD_HUNK = /^@@ HUNK (\S+) @@/;
const NUD_ROW = /^ *([0-9]+|\.) \| *([0-9]+|\.) \| ([ +-])(.*)$/;
const ROW_KINDS = { " ": "context", "+": "add", "-": "del" };

function parseNud(prompt) {
	const files = [];
	let currentFile = null;
	let currentHunk = null;
	for (const line of prompt.split("\n")) {
		const file = NUD_FILE.exec(line);
		if (file !== null) {
			currentFile = { path: file[2], hunks: [] };
			currentHunk = null;
			files.push(currentFile);
			continue;
		}
		const hunk = NUD_HUNK.exec(line);
		if (hunk !== null && currentFile !== null) {
			currentHunk = { id: hunk[1], rows: [] };
			currentFile.hunks.push(currentHunk);
			continue;
		}
		const row = NUD_ROW.exec(line);
		if (row !== null && currentHunk !== null) {
			currentHunk.rows.push({
				kind: ROW_KINDS[row[3]],
				oldLine: row[1] === "." ? null : Number(row[1]),
				newLine: row[2] === "." ? null : Number(row[2]),
				content: row[4],
			});
		}
	}
	return files;
}

/** every hunk id of a file, in NUD order */
function hunkIdsOf(file) {
	return file.hunks.map((hunk) => hunk.id);
}

// ── the understanding ───────────────────────────────────────────────────────

/**
 * A change retold as topics, arranged to put every state of the tab on screen
 * at once.
 *
 * The point of a mock is the cases a real run gives you one at a time and only
 * by luck: overlapping topics so the coverage percentages overshoot, a topic
 * naming no code, a whole-file ref beside id-level refs, a title and a summary
 * at their exact character caps, every `kind` chip, and hunks left over so the
 * uncovered notice appears. Reading it should tell you the layout holds.
 *
 * Caps and the kind list are read from the schema rather than hardcoded, so
 * this cannot drift out of agreement with `understandingSchemas.ts` — and a
 * round whose `topicGranularity` allows fewer topics gets fewer.
 */
function buildUnderstanding(files, schema, random) {
	const topicSchema = schema.properties.topics;
	const itemSchema = topicSchema.items.properties;
	const kinds = itemSchema.kind.enum;
	const titleMax = itemSchema.title.maxLength;
	const summaryMax = itemSchema.summary.maxLength;

	const pairs = files.flatMap((file) =>
		hunkIdsOf(file).map((hunkId) => ({ path: file.path, hunkId })),
	);
	// one hunk held back so the "not covered by any topic" notice renders
	const reserved = pairs.length >= 4 ? 1 : 0;
	const covered = pairs.slice(0, pairs.length - reserved);

	const topicCount = Math.max(
		1,
		Math.min(topicSchema.maxItems ?? 6, kinds.length, Math.max(2, files.length)),
	);

	const buckets = Array.from({ length: topicCount }, () => []);
	covered.forEach((pair, index) => {
		buckets[index % topicCount].push(pair);
	});

	// a hunk that serves two topics, which is the case the percentages exist to
	// survive: this is why they are allowed to add up to more than 100%
	if (topicCount > 1 && buckets[0].length > 0) {
		buckets[1].push(buckets[0][0]);
	}
	// a topic that names no code, which the block renders as its own empty state
	if (topicCount > 3) {
		buckets[3] = [];
	}

	const topics = buckets.map((bucket, index) => ({
		title: sentence(random, index === 4 ? titleMax : 40, titleMax),
		summary: sentence(random, index === 4 ? summaryMax : 130, summaryMax),
		kind: kinds[index % kinds.length],
		// index 1 also carries a whole-file ref, so both ref shapes are on screen
		refs: refsOf(bucket, index === 1),
	}));

	const pointMax = schema.properties.summary.items.maxLength;
	const pointCount = schema.properties.summary.maxItems ?? 5;

	return {
		headline: sentence(random, 90, schema.properties.headline.maxLength),
		summary: Array.from({ length: pointCount }, (_, index) =>
			sentence(random, index === 0 ? pointMax : 110, pointMax),
		),
		topics,
		suggestedEntryPoint: files[0]?.path ?? "src/index.ts",
		goalMatch: {
			verdict: verdict(schema.properties.goalMatch.properties.verdict.enum),
			rationale: sentence(
				random,
				150,
				schema.properties.goalMatch.properties.rationale.maxLength,
			),
		},
	};
}

/** hunk pairs grouped into one ref per path; `wholeFile` empties the first one */
function refsOf(bucket, wholeFile) {
	const byPath = new Map();
	for (const { path, hunkId } of bucket) {
		const hunkIds = byPath.get(path) ?? [];
		hunkIds.push(hunkId);
		byPath.set(path, hunkIds);
	}
	const refs = [...byPath].map(([path, hunkIds]) => ({ path, hunkIds }));
	if (wholeFile && refs.length > 0) {
		// empty hunkIds is the schema's way of saying "the whole file"
		refs[0] = { path: refs[0].path, hunkIds: [] };
	}
	return refs;
}

function verdict(allowed) {
	const asked = process.env.MOCK_AGENT_VERDICT;
	return asked !== undefined && allowed.includes(asked) ? asked : allowed[0];
}

// ── anything that is not the comprehension pass ─────────────────────────────

/**
 * A schema-shaped instance of lorem, so a task this mock has no opinion about
 * still returns something the zod gate accepts.
 *
 * Findings and chat land here. What comes back is structurally valid and
 * semantically meaningless, which is the honest offer: it proves a surface
 * renders and tells you nothing about whether it renders *well*. Give a task
 * its own builder above when you actually want to look at it.
 */
function instanceOf(schema, random) {
	if (Array.isArray(schema.enum)) {
		return schema.enum[0];
	}
	switch (schema.type) {
		case "object": {
			const value = {};
			for (const [key, child] of Object.entries(schema.properties ?? {})) {
				value[key] = instanceOf(child, random);
			}
			return value;
		}
		case "array": {
			const count = Math.max(schema.minItems ?? 0, 1);
			const capped = Math.min(count, schema.maxItems ?? count);
			return Array.from({ length: capped }, () =>
				instanceOf(schema.items ?? {}, random),
			);
		}
		case "integer":
		case "number":
			return schema.minimum ?? 1;
		case "boolean":
			return false;
		default:
			return sentence(random, 60, schema.maxLength ?? 120);
	}
}

// ── lorem ───────────────────────────────────────────────────────────────────

const LOREM = [
	"lorem", "ipsum", "dolor", "sit", "amet", "consectetur", "adipiscing",
	"elit", "sed", "do", "eiusmod", "tempor", "incididunt", "ut", "labore",
	"et", "dolore", "magna", "aliqua", "enim", "ad", "minim", "veniam", "quis",
	"nostrud", "exercitation", "ullamco", "laboris", "nisi", "aliquip", "ex",
	"ea", "commodo", "consequat", "duis", "aute", "irure", "in",
	"reprehenderit", "voluptate", "velit", "esse", "cillum", "eu", "fugiat",
	"nulla", "pariatur", "excepteur", "sint", "occaecat", "cupidatat", "non",
	"proident", "sunt", "culpa", "qui", "officia", "deserunt", "mollit",
	"anim", "id", "est", "laborum",
];

/**
 * Lorem of a target length, never past `hard`.
 *
 * `hard` is the schema's own cap, and hitting it exactly is a deliberate test
 * case rather than an accident: a title allowed 60 characters should be seen at
 * 60 before a real run finds the wrapping bug for you.
 */
function sentence(random, target, hard) {
	const limit = Math.min(target, hard);
	let text = "";
	while (text.length < limit) {
		const word = LOREM[Math.floor(random() * LOREM.length)];
		const next = text === "" ? word : `${text} ${word}`;
		if (next.length > limit) {
			break;
		}
		text = next;
	}
	if (text === "") {
		text = LOREM[0].slice(0, limit);
	}
	return `${text.charAt(0).toUpperCase()}${text.slice(1)}`.slice(0, hard);
}

/** mulberry32, so the same changeset always mocks to the same screen */
function seededRandom(seed) {
	let state = Number.parseInt(sha(seed).slice(0, 8), 16) >>> 0;
	return () => {
		state = (state + 0x6d2b79f5) >>> 0;
		let t = state;
		t = Math.imul(t ^ (t >>> 15), t | 1);
		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

// ── the stream ──────────────────────────────────────────────────────────────

/**
 * Tool calls the run has no use for except as something to say it is doing.
 *
 * The status bar's whole job is that a run always narrates itself, so a mock
 * that answered in one frame would leave the surface it is meant to exercise
 * untested. These are what `RunProgress` coalesces into `run.progress`.
 *
 * The paths are the changeset's own, which used to matter less than it does
 * now: this was one hardcoded `src/index.ts`, so the round's read log held a
 * single irrelevant entry. That is a mock claiming to have read a file that is
 * not in front of it — the same class of dishonesty this whole generator exists
 * to remove — and it made every grounding check fail for reasons unrelated to
 * the code being checked.
 */
function narration(files) {
	const paths = files.slice(0, 3).map((file) => file.path);
	if (paths.length === 0) {
		return [["Glob", { pattern: "**/*" }]];
	}
	return [
		["Glob", { pattern: "**/*.ts" }],
		...paths.map((path) => ["Read", { file_path: path }]),
		["Grep", { pattern: "export function" }],
	];
}

async function emit(toolCalls, structuredOutput) {
	const delayMs = Number(process.env.MOCK_AGENT_DELAY_MS ?? DEFAULT_DELAY_MS);
	const write = async (event) => {
		if (delayMs > 0) {
			await sleep(delayMs);
		}
		process.stdout.write(`${JSON.stringify(event)}\n`);
	};

	await write({
		type: "system",
		subtype: "init",
		session_id: SESSION_ID,
		cwd: process.cwd(),
		model: "mock",
	});

	for (const [index, [name, input]] of toolCalls.entries()) {
		const id = `toolu_mock_${index}`;
		await write({
			type: "assistant",
			session_id: SESSION_ID,
			message: { role: "assistant", content: [{ type: "tool_use", id, name, input }] },
		});
		await write({
			type: "user",
			session_id: SESSION_ID,
			message: {
				role: "user",
				content: [{ type: "tool_result", tool_use_id: id, content: "ok" }],
			},
		});
	}

	if (process.env.MOCK_AGENT_FAIL) {
		await write({
			type: "result",
			subtype: "error_during_execution",
			is_error: true,
			session_id: SESSION_ID,
			num_turns: toolCalls.length,
			total_cost_usd: 0,
			terminal_reason: "error",
			result: "mock agent: forced failure (MOCK_AGENT_FAIL)",
			api_error_status: null,
		});
		process.exit(1);
	}

	await write({
		type: "result",
		subtype: "success",
		is_error: false,
		session_id: SESSION_ID,
		num_turns: toolCalls.length + 1,
		total_cost_usd: 0,
		terminal_reason: "completed",
		result: JSON.stringify(structuredOutput),
		structured_output: structuredOutput,
		api_error_status: null,
	});
}

// ── argv and stdin ──────────────────────────────────────────────────────────

function parseJsonFlag(flag) {
	const index = argv.indexOf(flag);
	if (index < 0) {
		return null;
	}
	try {
		return JSON.parse(argv[index + 1]);
	} catch {
		return null;
	}
}

function readStdinToEnd() {
	try {
		return readFileSync(0, "utf8");
	} catch {
		return "";
	}
}

function sha(value) {
	return createHash("sha256").update(value).digest("hex");
}

// Started from the bottom on purpose: `main` runs synchronously up to its first
// await, so calling it above the `const` declarations it reaches — LOREM among
// them — is a temporal-dead-zone crash rather than the mock you asked for.
main().catch((error) => {
	process.stderr.write(`mock agent: ${error.message}\n`);
	process.exit(2);
});
