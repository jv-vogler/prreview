#!/usr/bin/env node
// A mock `claude` for looking at the review UI without paying an agent.
//
// This is a *generator*, not a replay. `test/bin/claude` replays a recorded
// stream byte for byte, which is what a test wants and exactly what UI work
// cannot use: a recording's line numbers belong to the repo it was recorded
// against, so against any other changeset every finding would be
// unplaceable and the screen you are trying to look at is not the screen
// users get. This one reads the numbered diff out of the prompt it was
// handed (reviewPrompt.ts's own format) and answers with findings anchored
// to real line numbers actually in front of it.
//
// It is a real agent as far as everything else is concerned: it goes on
// PATH as `claude`, so the run manager, the progress events, the SSE
// channel, the zod gate and the store all run the production path.
//
// CJS on purpose — extensionless scripts load as CJS regardless of the root
// "type": "module".
//
// Usage:  npm run dev:mock     (then click "Review")
//
// Knobs:
//   MOCK_AGENT_DELAY_MS   ms between emitted lines (default 150; 0 for instant)
//   MOCK_AGENT_FAIL       any value → terminal failure, for the error surface
//   MOCK_AGENT_EMPTY      any value → a clean pass with no findings

const { setTimeout: sleep } = require("node:timers/promises");

const VERSION = "0.0.0-mock (prreview mock agent)";
const DEFAULT_DELAY_MS = 150;
const SESSION_ID = "00000000-mock-4000-8000-000000000000";

const argv = process.argv.slice(2);

main().catch((error) => {
	process.stderr.write(`mock claude: ${error.message}\n`);
	process.exit(1);
});

async function main() {
	if (argv.includes("--version") || argv.includes("-v")) {
		process.stdout.write(`${VERSION}\n`);
		return;
	}

	const prompt = readStdinToEnd();
	const delayMs = Number(process.env.MOCK_AGENT_DELAY_MS ?? DEFAULT_DELAY_MS);
	const files = parseNumberedDiff(prompt);

	await emitLine({ type: "system", subtype: "init", session_id: SESSION_ID, cwd: process.cwd(), model: "mock-agent" });
	await sleep(delayMs);

	// advances the same five-step plan reviewPrompt.ts asks the real agent
	// for, interleaved with the Read bursts — without this the itinerary
	// rail is invisible to `npm run dev:mock`
	await emitPlanCreated();
	await sleep(delayMs);
	await emitTaskUpdate(0, "in_progress");
	await sleep(delayMs);
	await emitTaskUpdate(0, "completed");
	await emitTaskUpdate(1, "in_progress");
	await sleep(delayMs);

	const midpoint = Math.ceil(files.length / 2);
	for (const file of files.slice(0, midpoint)) {
		await emitToolUse("Read", { file_path: file.path });
		await sleep(delayMs);
	}

	await emitTaskUpdate(1, "completed");
	await emitTaskUpdate(2, "in_progress");
	await sleep(delayMs);

	for (const file of files.slice(midpoint)) {
		await emitToolUse("Read", { file_path: file.path });
		await sleep(delayMs);
	}

	await emitTaskUpdate(2, "completed");
	await emitTaskUpdate(3, "in_progress");
	await sleep(delayMs);
	await emitTaskUpdate(3, "completed");
	await emitTaskUpdate(4, "in_progress");
	await sleep(delayMs);

	if (process.env.MOCK_AGENT_FAIL !== undefined) {
		await emitLine({
			type: "result",
			is_error: true,
			subtype: "error_during_execution",
			terminal_reason: "api_error",
			api_error_status: 429,
			session_id: SESSION_ID,
			num_turns: files.length + 1,
			total_cost_usd: 0.01,
			result: "mock: simulated rate limit (MOCK_AGENT_FAIL)",
		});
		return;
	}

	const pass = process.env.MOCK_AGENT_EMPTY === undefined
		? buildPass(files)
		: { overview: "A clean pass: nothing worth flagging.", verdict: "no ticket was found (mock)", scope: "no-ticket", ticket: null, findings: [] };

	await emitTaskUpdate(4, "completed");
	await emitLine({
		type: "result",
		is_error: false,
		subtype: "success",
		session_id: SESSION_ID,
		num_turns: files.length + 1,
		total_cost_usd: 0.01,
		result: "mock review complete",
		structured_output: pass,
	});
}

/**
 * Parses `reviewPrompt.ts`'s `### path — status` / fenced ```diff blocks
 * back into `{path, lines: [{lineNumber, marker, content}]}`. Anything the
 * format does not recognize is simply not a file — a reworded prompt
 * degrades to zero findings, never to a crash.
 */
function parseNumberedDiff(prompt) {
	const change = prompt.split("## The change\n\n")[1] ?? "";
	const sections = change.split(/\n(?=### )/);
	const files = [];
	for (const section of sections) {
		const heading = /^### (.+?)(?: \(renamed from .+?\))? — \S+/.exec(section);
		if (heading === null) {
			continue;
		}
		const path = heading[1];
		const fenced = /```diff\n([\s\S]*?)\n```/.exec(section);
		if (fenced === null) {
			continue;
		}
		const lines = [];
		for (const line of fenced[1].split("\n")) {
			const matched = /^(\d+) ([+\- ]) (.*)$/.exec(line);
			if (matched !== null) {
				lines.push({ lineNumber: Number(matched[1]), marker: matched[2], content: matched[3] });
			}
		}
		files.push({ path, lines });
	}
	return files;
}

const TIERS = ["blocker", "should-fix", "suggestion", "nitpick"];

function buildPass(files) {
	const findings = files.slice(0, 3).map((file, index) => {
		const added = file.lines.filter((line) => line.marker === "+");
		const anchor = added[0] ?? file.lines[0];
		const line = anchor?.lineNumber ?? 1;
		return {
			path: file.path,
			startLine: line,
			endLine: line,
			kind: "defect",
			tier: TIERS[index % TIERS.length],
			title: `Mock finding on ${file.path}`,
			body: `> [!${alertFor(TIERS[index % TIERS.length])}]\n> **${TIERS[index % TIERS.length]}** — generated by the mock agent, not a real finding.\n\nThe paragraph sits outside the alert block, which is the shape a real pass has to produce; this sentence exists so the renderer has prose to lay out.`,
			evidence: `\`\`\`diff\n-  const mock = "before";\n+  const mock = "after";\n\`\`\``,
			proof: "Inferred: this is the mock agent, nothing was actually run.",
			verified: false,
			lane: "review",
		};
	});
	if (files.length > 0) {
		// exercises REQ-010's unplaceable lane (a path outside the diff),
		// same as the sidebar has to handle for a real run's finding that
		// cites a file the reader is not looking at
		findings.push({
			path: "does/not/exist/in/this/diff.ts",
			startLine: 1,
			endLine: 1,
			kind: "defect",
			tier: "nitpick",
			title: "Mock unplaceable finding",
			body: "> [!NOTE]\n> Generated by the mock agent to exercise REQ-010's unplaceable lane.",
			proof: "Inferred: this is the mock agent, nothing was actually run.",
			verified: false,
			lane: "review",
		});
		// a question: no tier, no alert block, its own count and chip in the
		// sidebar — the whole point being visible without a paid run
		const questionAnchor = files[0].lines.find((line) => line.marker === "+") ?? files[0].lines[0];
		findings.push({
			path: files[0].path,
			startLine: questionAnchor?.lineNumber ?? 1,
			endLine: questionAnchor?.lineNumber ?? 1,
			kind: "question",
			title: "Mock question about a choice the code does not explain",
			body: "Why is this done here rather than in the caller, which already holds the same value?",
			proof: "Looked at the callers and the sibling module; neither answers it.",
			verified: false,
			lane: "review",
		});
	}
	const explanations = buildExplanations(files);
	const labels = [
		...new Set(explanations.map((entry) => entry.topic).filter(Boolean)),
	];
	const topicsLine =
		labels.length === 0
			? ""
			: `\n\nThe change groups under ${labels.join(" and ")}.`;
	return {
		overview: `Reviewed ${files.length} file(s) with the mock agent (no real analysis happened).${topicsLine}`,
		verdict: "matches the ticket (mock)",
		scope: "matches",
		ticket: null,
		findings,
		explanations,
	};
}

// 2–3 explanations anchored to real parsed lines, at least two sharing a
// `topic`, so `npm run dev:mock` shows the balloons and the grouping
// without a paid run
function buildExplanations(files) {
	const explanations = files.slice(0, 3).map((file, index) => {
		const anchor =
			file.lines.filter((line) => line.marker === "+").at(-1) ?? file.lines.at(-1);
		const line = anchor?.lineNumber ?? 1;
		return {
			path: file.path,
			startLine: line,
			endLine: line,
			says: [
				`Mock account of what ${file.path} now does.`,
				"It exists so the balloon has more than one sentence to lay out.",
			],
			// one reconstruction among read reasons, so `grounding` is
			// exercised on both values even though nothing renders it
			grounding: index === 0 ? "inferred" : "code",
			...(index < 2
				? { topic: "Mock intent: two files change for one reason" }
				: { topic: "Mock second theme: the supporting change" }),
		};
	});
	// one with no line in the diff, so the sidebar's explanation section
	// (the never-silently-lost lane) is visible without a paid run
	explanations.push({
		path: "not/in/the/diff.ts",
		startLine: 7,
		endLine: 7,
		says: ["Mock explanation the diff cannot anchor."],
		grounding: "code",
	});
	return explanations;
}

function alertFor(tier) {
	switch (tier) {
		case "blocker":
			return "CAUTION";
		case "should-fix":
			return "WARNING";
		case "suggestion":
			return "TIP";
		default:
			return "NOTE";
	}
}

// mirrors reviewPrompt.ts's "## Working plan" five steps, in order
const PLAN_STEPS = [
	{ subject: "Find the ticket", activeForm: "Finding the ticket" },
	{ subject: "Read the big picture", activeForm: "Reading the big picture" },
	{ subject: "Find problems", activeForm: "Finding problems" },
	{ subject: "Verify findings", activeForm: "Verifying findings" },
	{ subject: "Write it up", activeForm: "Writing it up" },
];

// TaskCreate appends one task per call and TaskUpdate moves one by id, ids
// running from 1 in creation order — the real print-mode shape, since
// TodoWrite does not exist under `claude -p`.
async function emitPlanCreated() {
	for (const step of PLAN_STEPS) {
		await emitToolUse("TaskCreate", { ...step, description: step.subject });
	}
}

async function emitTaskUpdate(index, status) {
	await emitToolUse("TaskUpdate", { taskId: String(index + 1), status });
}

async function emitToolUse(name, input) {
	await emitLine({
		type: "assistant",
		message: { content: [{ type: "tool_use", id: `mock-${name}-${Math.random().toString(36).slice(2)}`, name, input }] },
	});
}

async function emitLine(event) {
	process.stdout.write(`${JSON.stringify(event)}\n`);
}

function readStdinToEnd() {
	try {
		return require("node:fs").readFileSync(0, "utf8");
	} catch {
		return "";
	}
}
