#!/usr/bin/env node
// fake-claude: replays a captured `claude -p --output-format stream-json --verbose`
// event stream from a fixture file, byte-faithful per line, then exits with the
// recorded exit code. Fixture selected via FAKE_CLAUDE_FIXTURE (a .jsonl capture).
// Reproduces the real CLI's flag contract for the flags the engine adapter uses.

const fs = require('node:fs');

const argv = process.argv.slice(2);

if (argv.includes('--version') || argv.includes('-v')) {
  process.stdout.write('2.1.233 (Claude Code)\n');
  process.exit(0);
}

const has = (f) => argv.includes(f);
const val = (f) => {
  const i = argv.indexOf(f);
  return i >= 0 ? argv[i + 1] : undefined;
};

// Real CLI contract observed on 2.1.233:
if (val('--output-format') === 'stream-json' && has('-p') && !has('--verbose')) {
  process.stderr.write('Error: When using --print, --output-format=stream-json requires --verbose\n');
  process.exit(1);
}

const fixture = process.env.FAKE_CLAUDE_FIXTURE;
if (!fixture) {
  process.stderr.write('fake-claude: set FAKE_CLAUDE_FIXTURE to a capture .jsonl\n');
  process.exit(2);
}

const lines = fs.readFileSync(fixture, 'utf8').split('\n').filter(Boolean);
let exitCode = 0;
for (const line of lines) {
  // A trailing non-JSON control line "#exit <code>" sets the exit code.
  if (line.startsWith('#exit ')) {
    exitCode = Number(line.slice(6));
    continue;
  }
  process.stdout.write(line + '\n');
}
process.exit(exitCode);
