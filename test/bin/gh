#!/bin/sh
# Fake gh CLI for adapter tests: emits canned output so the suite runs with
# no real gh and no network. Knobs, all optional:
#   FAKE_GH_LOG                 append each invocation's argv to this file
#   FAKE_GH_VERSION_EXIT        exit code for `gh --version`        (default 0)
#   FAKE_GH_AUTH_EXIT           exit code for `gh auth token`       (default 0)
#   FAKE_GH_PR_VIEW_EXIT        exit code for `gh pr view`          (default 0)
#   FAKE_GH_PR_VIEW_JSON        stdout override for `gh pr view`
#   FAKE_GH_PR_DIFF_EXIT        exit code for `gh pr diff`          (default 0)
#   FAKE_GH_PR_DIFF             stdout override for `gh pr diff`
#   FAKE_GH_REVIEWS_JSON        stdout override for `gh api .../reviews` (GET)
#   FAKE_GH_REVIEW_CREATE_EXIT  exit code for `gh api .../reviews -X POST` (default 0)
#   FAKE_GH_REVIEW_CREATE_JSON  stdout override for the create call
#   FAKE_GH_REVIEW_DELETE_EXIT  exit code for `gh api .../reviews/<id> -X DELETE` (default 0)

if [ -n "$FAKE_GH_LOG" ]; then
	printf '%s\n' "$*" >>"$FAKE_GH_LOG"
fi

if [ "$1" = "--version" ]; then
	echo "gh version 2.62.0 (fake)"
	exit "${FAKE_GH_VERSION_EXIT:-0}"
fi

if [ "$1" = "auth" ] && [ "$2" = "token" ]; then
	if [ "${FAKE_GH_AUTH_EXIT:-0}" -ne 0 ]; then
		echo "no oauth token found" >&2
		exit "${FAKE_GH_AUTH_EXIT}"
	fi
	echo "gho_faketoken0000000000000000000000000000"
	exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
	if [ "${FAKE_GH_PR_VIEW_EXIT:-0}" -ne 0 ]; then
		echo "no pull requests found" >&2
		exit "${FAKE_GH_PR_VIEW_EXIT}"
	fi
	# printf is a shell builtin: the fake must run on a PATH holding nothing
	# but git, so no external command (cat, sed, …) may appear in this script.
	canned_json='{
	"title": "Add rate limiting",
	"body": "Token bucket per client.",
	"baseRefName": "main",
	"headRefName": "feat/rate-limit",
	"headRefOid": "0123456789abcdef0123456789abcdef01234567",
	"url": "https://github.com/acme/api/pull/482",
	"state": "OPEN"
}'
	printf '%s\n' "${FAKE_GH_PR_VIEW_JSON:-$canned_json}"
	exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "diff" ]; then
	if [ "${FAKE_GH_PR_DIFF_EXIT:-0}" -ne 0 ]; then
		echo "could not find pull request diff" >&2
		exit "${FAKE_GH_PR_DIFF_EXIT}"
	fi
	canned_diff='diff --git a/src/limiter.ts b/src/limiter.ts
index 1111111..2222222 100644
--- a/src/limiter.ts
+++ b/src/limiter.ts
@@ -1,3 +1,4 @@
 export function limit() {
-  return false;
+  const allowed = bucket.take();
+  return allowed;
 }'
	printf '%s\n' "${FAKE_GH_PR_DIFF:-$canned_diff}"
	exit 0
fi

# `gh api <endpoint> [-X <method>] [--input -]` — the review-publish surface
# (docs/github-review-notes.md). No real substitution of {owner}/{repo}
# happens here (that is the real gh binary's own job); the fake matches on
# the endpoint's shape instead. --input's value is never read: the caller
# closes stdin after writing, so leaving it unread cannot hang this script.
if [ "$1" = "api" ]; then
	endpoint="$2"
	shift 2
	method="GET"
	while [ $# -gt 0 ]; do
		case "$1" in
			-X)
				method="$2"
				shift 2
				;;
			--input)
				shift 2
				;;
			*)
				shift
				;;
		esac
	done

	case "$endpoint" in
		*/reviews/*)
			if [ "$method" = "DELETE" ]; then
				exit "${FAKE_GH_REVIEW_DELETE_EXIT:-0}"
			fi
			;;
		*/reviews)
			if [ "$method" = "POST" ]; then
				if [ "${FAKE_GH_REVIEW_CREATE_EXIT:-0}" -ne 0 ]; then
					echo '{"message":"Unprocessable Entity","errors":["Line could not be resolved"]}' >&2
					exit "${FAKE_GH_REVIEW_CREATE_EXIT}"
				fi
				canned_review='{"id": 1001, "html_url": "https://github.com/acme/api/pull/482#pullrequestreview-1001", "state": "PENDING"}'
				printf '%s\n' "${FAKE_GH_REVIEW_CREATE_JSON:-$canned_review}"
				exit 0
			fi
			canned_reviews='[{"id": 1001, "html_url": "https://github.com/acme/api/pull/482#pullrequestreview-1001", "state": "PENDING"}]'
			printf '%s\n' "${FAKE_GH_REVIEWS_JSON:-$canned_reviews}"
			exit 0
			;;
	esac
	echo "fake gh: unexpected api invocation: $endpoint $method" >&2
	exit 64
fi

echo "fake gh: unexpected invocation: $*" >&2
exit 64
