#!/bin/sh
# Fake gh CLI for adapter tests (ARCHITECTURE §16): emits canned output so the
# suite runs with no real gh and no network. Knobs, all optional:
#   FAKE_GH_LOG            append each invocation's argv to this file
#   FAKE_GH_VERSION_EXIT   exit code for `gh --version`        (default 0)
#   FAKE_GH_AUTH_EXIT      exit code for `gh auth token`       (default 0)
#   FAKE_GH_PR_VIEW_EXIT   exit code for `gh pr view`          (default 0)
#   FAKE_GH_PR_VIEW_JSON   stdout override for `gh pr view`
#   FAKE_GH_PR_DIFF_EXIT   exit code for `gh pr diff`          (default 0)
#   FAKE_GH_PR_DIFF        stdout override for `gh pr diff`

if [ -n "$FAKE_GH_LOG" ]; then
	printf '%s\n' "$*" >>"$FAKE_GH_LOG"
fi

if [ "$1" = "--version" ]; then
	echo "gh version 2.62.0 (fake)"
	exit "${FAKE_GH_VERSION_EXIT:-0}"
fi

if [ "$1" = "auth" ] && [ "$2" = "token" ]; then
	if [ "${FAKE_GH_AUTH_EXIT:-0}" -ne 0 ]; then
		echo "no oauth token found" >&2
		exit "${FAKE_GH_AUTH_EXIT}"
	fi
	echo "gho_faketoken0000000000000000000000000000"
	exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
	if [ "${FAKE_GH_PR_VIEW_EXIT:-0}" -ne 0 ]; then
		echo "no pull requests found" >&2
		exit "${FAKE_GH_PR_VIEW_EXIT}"
	fi
	# printf is a shell builtin: the fake must run on a PATH holding nothing
	# but git, so no external command (cat, sed, …) may appear in this script.
	canned_json='{
	"title": "Add rate limiting",
	"body": "Token bucket per client.",
	"baseRefName": "main",
	"headRefName": "feat/rate-limit",
	"headRefOid": "0123456789abcdef0123456789abcdef01234567",
	"url": "https://github.com/acme/api/pull/482",
	"state": "OPEN"
}'
	printf '%s\n' "${FAKE_GH_PR_VIEW_JSON:-$canned_json}"
	exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "diff" ]; then
	if [ "${FAKE_GH_PR_DIFF_EXIT:-0}" -ne 0 ]; then
		echo "could not find pull request diff" >&2
		exit "${FAKE_GH_PR_DIFF_EXIT}"
	fi
	canned_diff='diff --git a/src/limiter.ts b/src/limiter.ts
index 1111111..2222222 100644
--- a/src/limiter.ts
+++ b/src/limiter.ts
@@ -1,3 +1,4 @@
 export function limit() {
-  return false;
+  const allowed = bucket.take();
+  return allowed;
 }'
	printf '%s\n' "${FAKE_GH_PR_DIFF:-$canned_diff}"
	exit 0
fi

echo "fake gh: unexpected invocation: $*" >&2
exit 64
