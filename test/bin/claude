#!/bin/sh
# Fake claude CLI for toolchain-probe tests (ARCHITECTURE §16). Knobs:
#   FAKE_CLAUDE_EXIT      exit code for any invocation   (default 0)
#   FAKE_CLAUDE_VERSION   stdout for `claude --version`  (default below)

if [ "${FAKE_CLAUDE_EXIT:-0}" -ne 0 ]; then
	echo "fake claude: forced failure" >&2
	exit "${FAKE_CLAUDE_EXIT}"
fi

echo "${FAKE_CLAUDE_VERSION:-2.0.0 (Claude Code)}"
exit 0
