#!/usr/bin/env node
// Fake claude CLI: replays a captured `claude -p --output-format stream-json
// --verbose` event stream from a fixture, byte-faithful per line, then exits
// with the recorded exit code. CJS on purpose — extensionless scripts load
// as CJS regardless of the root "type": "module".
//
// Two real-CLI contracts are reproduced unconditionally, with no knob to
// disable them, because each one is a way a run fails in production while
// the suite stays green: `-p --output-format stream-json` requires
// `--verbose` (CON-001), and `--json-schema` must survive Ajv 8 draft-07
// validation (CON-002).
//
// Knobs (all test-only, never read by src/):
//   FAKE_CLAUDE_VERSION      stdout for `claude --version` (default below)
//   FAKE_CLAUDE_EXIT         non-zero → forced failure with that exit code
//   FAKE_CLAUDE_FIXTURE      capture .jsonl to replay
//   FAKE_CLAUDE_LOG          append one JSON line per invocation:
//                            {pid, argv, cwd, stdinBytes, stdinSha256} — the
//                            pid is how a test proves the child is gone
//   FAKE_CLAUDE_DELAY_MS     sleep between emitted lines (cancel/timeout tests)
//   FAKE_CLAUDE_TRAP_SIGTERM survive SIGTERM and log {event} lifecycle records
//                            ({"event":"sigterm"} on the signal,
//                            {"event":"completed"} if the replay ever ends) —
//                            the only way to observe SEC-002's SIGKILL escalation

const { appendFileSync, existsSync, readFileSync } = require("node:fs");
const { createHash } = require("node:crypto");
const { setTimeout: sleep } = require("node:timers/promises");

const DEFAULT_VERSION = "2.1.239 (Claude Code)";
const MISSING_FIXTURE_EXIT_CODE = 2;
// The real CLI rejects a bad --json-schema before it spawns anything (CON-002).
const BAD_SCHEMA_EXIT_CODE = 1;
// A trailing non-JSON control line "#exit <code>" sets the exit code.
const EXIT_CONTROL_PREFIX = "#exit ";

const argv = process.argv.slice(2);

main().catch((error) => {
	process.stderr.write(`fake claude: ${error.message}\n`);
	process.exit(MISSING_FIXTURE_EXIT_CODE);
});

async function main() {
	// Forced failure wins over --version: the knob simulates a broken binary,
	// and the toolchain probe must see `claude --version` itself fail.
	const forcedExitCode = Number(process.env.FAKE_CLAUDE_EXIT ?? 0);
	if (forcedExitCode !== 0) {
		appendInvocationLog("");
		process.stderr.write("fake claude: forced failure\n");
		process.exit(forcedExitCode);
	}

	if (argv.includes("--version") || argv.includes("-v")) {
		appendInvocationLog("");
		process.stdout.write(`${process.env.FAKE_CLAUDE_VERSION ?? DEFAULT_VERSION}\n`);
		process.exit(0);
	}

	// Real CLI contract (CON-001).
	if (
		argv.includes("-p") &&
		flagValue("--output-format") === "stream-json" &&
		!argv.includes("--verbose")
	) {
		appendInvocationLog("");
		process.stderr.write(
			"Error: When using --print, --output-format=stream-json requires --verbose\n",
		);
		process.exit(1);
	}

	// CON-002: argv validation happens before any work, so this sits above the
	// stdin read exactly as the --verbose contract above it does.
	const schemaFailure = jsonSchemaFailure(flagValue("--json-schema"));
	if (schemaFailure !== null) {
		appendInvocationLog("");
		process.stderr.write(`${schemaFailure}\n`);
		process.exit(BAD_SCHEMA_EXIT_CODE);
	}

	const stdinContent = readStdinToEnd();
	appendInvocationLog(stdinContent);

	const fixturePath = process.env.FAKE_CLAUDE_FIXTURE;
	if (fixturePath === undefined || !existsSync(fixturePath)) {
		process.stderr.write(
			`fake claude: no fixture for this invocation (FAKE_CLAUDE_FIXTURE=${fixturePath ?? ""})\n`,
		);
		process.exit(MISSING_FIXTURE_EXIT_CODE);
	}

	trapSigtermWhenAsked();

	const delayMs = Number(process.env.FAKE_CLAUDE_DELAY_MS ?? 0);
	const lines = readFileSync(fixturePath, "utf8").split("\n").filter(Boolean);
	let exitCode = 0;
	for (const line of lines) {
		if (line.startsWith(EXIT_CONTROL_PREFIX)) {
			exitCode = Number(line.slice(EXIT_CONTROL_PREFIX.length));
			continue;
		}
		if (delayMs > 0) {
			await sleep(delayMs);
		}
		process.stdout.write(`${line}\n`);
	}
	appendLifecycleEvent("completed");
	process.exit(exitCode);
}

/**
 * CON-002: the real CLI validates `--json-schema` with **Ajv 8 in draft-07
 * mode** before it spawns anything, so a schema Ajv cannot even compile
 * fails the run at argv time with nothing on stdout.
 *
 * Doing the validation here is what makes that class of bug (a schema built
 * at `target: "draft-2020-12"`, whose `$schema` URI Ajv 8 has no meta-schema
 * for) unit-test-visible instead of a silent hole in the suite.
 *
 * Returns null when the flag is absent or the schema is fine.
 */
function jsonSchemaFailure(raw) {
	if (raw === undefined) {
		return null;
	}
	let parsed;
	try {
		parsed = JSON.parse(raw);
	} catch (error) {
		return `--json-schema is not valid JSON: ${error.message}`;
	}
	// ajv is a devDependency of the repo this fake ships in, pinned to the 8.x
	// the CLI validates with; resolution walks up to the root node_modules.
	const Ajv = require("ajv");
	const ajv = new Ajv({ strict: false });
	try {
		if (ajv.validateSchema(parsed) !== true) {
			return `--json-schema is not a valid JSON Schema: ${ajv.errorsText(ajv.errors)}`;
		}
	} catch (error) {
		return `--json-schema is not a valid JSON Schema: ${error.message}`;
	}
	return null;
}

/**
 * Only a child that refuses to die on SIGTERM can prove the adapter escalates
 * to SIGKILL, so this behavior is opt-in and off by default.
 */
function trapSigtermWhenAsked() {
	if (!process.env.FAKE_CLAUDE_TRAP_SIGTERM) {
		return;
	}
	process.on("SIGTERM", () => {
		appendLifecycleEvent("sigterm");
	});
}

function appendLifecycleEvent(event) {
	const logPath = process.env.FAKE_CLAUDE_LOG;
	if (!process.env.FAKE_CLAUDE_TRAP_SIGTERM || !logPath) {
		return;
	}
	appendFileSync(logPath, `${JSON.stringify({ event })}\n`);
}

/** stdin is how the prompt arrives; EOF-blocking read */
function readStdinToEnd() {
	try {
		return readFileSync(0, "utf8");
	} catch {
		// stdin closed or not a readable fd — an argv-only invocation
		return "";
	}
}

function flagValue(flag) {
	const index = argv.indexOf(flag);
	return index >= 0 ? argv[index + 1] : undefined;
}

function appendInvocationLog(stdinContent) {
	const logPath = process.env.FAKE_CLAUDE_LOG;
	if (logPath === undefined || logPath === "") {
		return;
	}
	const record = {
		pid: process.pid,
		argv,
		cwd: process.cwd(),
		stdinBytes: Buffer.byteLength(stdinContent),
		stdinSha256: createHash("sha256").update(stdinContent).digest("hex"),
	};
	appendFileSync(logPath, `${JSON.stringify(record)}\n`);
}
